# ============================================================
# TripCazador — Variables de entorno
# ============================================================
# 1. Copiar: cp .env.example .env.production
# 2. Rellenar valores reales
# 3. NUNCA subir .env.production a git
# ============================================================

# ── Base de datos ──────────────────────────────────────────
POSTGRES_DB=tripcazador
POSTGRES_USER=tripcazador
POSTGRES_PASSWORD=CAMBIAR_ESTO_POR_CLAVE_SEGURA

# ── APIs de vuelos ─────────────────────────────────────────
# Kiwi Tequila: https://tequila.kiwi.com/portal/login (GRATIS)
KIWI_API_KEY=

# SerpAPI: https://serpapi.com (100 gratis/mes)
SERPAPI_KEY=

# RapidAPI - Sky Scrapper: https://rapidapi.com/apiheya/api/sky-scrapper
RAPIDAPI_KEY=

# Duffel: https://duffel.com (token de test disponible tras sign-up)
DUFFEL_TOKEN=

# Travelpayouts: https://travelpayouts.com (GRATIS)
TRAVELPAYOUTS_TOKEN=
TP_MARKER=  # Tu número de afiliado (ej: 123456)

# ── Telegram ───────────────────────────────────────────────
# Crear bot: https://t.me/BotFather → /newbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── App ────────────────────────────────────────────────────
ENVIRONMENT=production
CRON_INTERVAL=21600  # 6 horas en segundos

# ── Web (Vercel o Oracle Cloud) ────────────────────────────
# En Vercel dashboard → Settings → Environment Variables
NEXT_PUBLIC_API_URL=https://api.tripcazador.com

# ── Analytics (opcional, usado si se define) ───────────────
# Google Analytics 4: https://analytics.google.com
NEXT_PUBLIC_GA_ID=            # ej. G-XXXXXXXXXX

# ── Monitoreo de errores (opcional) ────────────────────────
# Sentry: https://sentry.io (tier free 5k events/mes)
SENTRY_DSN=                   # backend (FastAPI)
NEXT_PUBLIC_SENTRY_DSN=       # frontend (Next.js)

# ── Backups (Backblaze B2, 10 GB gratis) ───────────────────
# https://www.backblaze.com/cloud-storage
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=tripcazador-backups

# ── Infra (usadas por bootstrap.sh y Caddy) ────────────────
DOMAIN=tripcazador.com
API_DOMAIN=api.tripcazador.com
EMAIL_LETSENCRYPT=admin@tripcazador.com
