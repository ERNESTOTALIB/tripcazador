[Unit]
Description=TripCazador stack (docker-compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/tripcazador
EnvironmentFile=/opt/tripcazador/.env
ExecStartPre=/usr/bin/docker compose pull
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=600

# Reinicio ante fallo del daemon, no de los contenedores
Restart=on-failure
RestartSec=30

# Seguridad
ProtectSystem=full
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
