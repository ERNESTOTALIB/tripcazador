{
  "manifest_version": 3,
  "name": "TripCazador — comparador de chollos",
  "short_name": "TripCazador",
  "version": "0.1.0",
  "description": "Te avisa cuando hay un chollo mejor para tu búsqueda actual en Skyscanner, Google Flights, Kayak, Booking o Vueling/Iberia.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://www.skyscanner.es/*",
    "https://www.skyscanner.com/*",
    "https://www.google.com/flights/*",
    "https://www.google.com/travel/flights*",
    "https://www.kayak.es/*",
    "https://www.kayak.com/*",
    "https://www.booking.com/*",
    "https://www.vueling.com/*",
    "https://www.iberia.com/*",
    "https://www.ryanair.com/*",
    "https://tripcazador.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.skyscanner.es/*",
        "https://www.skyscanner.com/*",
        "https://www.google.com/flights/*",
        "https://www.google.com/travel/flights*",
        "https://www.kayak.es/*",
        "https://www.booking.com/*"
      ],
      "js": ["src/content.js"],
      "css": ["src/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "TripCazador",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "author": "TripCazador",
  "homepage_url": "https://tripcazador.com",
  "minimum_chrome_version": "100"
}
