{
  "name": "tripcazador-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint && node scripts/check-rsc-event-handlers.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:staging": "BASE_URL=https://tripcazador-staging.vercel.app E2E_ENV=staging playwright test",
    "test:e2e:prod": "BASE_URL=https://tripcazador.com E2E_ENV=prod playwright test e2e/tests/multi_env_smoke.spec.ts e2e/tests/api_full.spec.ts --grep-invert Mutaciones",
    "test:e2e:smoke": "playwright test e2e/tests/multi_env_smoke.spec.ts",
    "test:e2e:api": "playwright test e2e/tests/api_full.spec.ts",
    "test:e2e:flows": "playwright test e2e/tests/search_flow_complete.spec.ts e2e/tests/premium_referral_push.spec.ts",
    "test": "vitest run --reporter=default --no-coverage --passWithNoTests",
    "test:watch": "vitest",
    "lint:rsc": "node scripts/check-rsc-event-handlers.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^8.55.2",
    "@tailwindcss/typography": "^0.5.13",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vercel/analytics": "^2.0.1",
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.0",
    "lucide-react": "^0.383.0",
    "next": "14.2.35",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.4.38",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^9.0.1",
    "react-simple-maps": "^3.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "stripe": "^17.7.0",
    "tailwindcss": "^3.4.1",
    "topojson-client": "^3.1.0",
    "typescript": "^5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.15.0",
    "wrangler": "^4.59.2",
    "@axe-core/playwright": "^4.9.0",
    "@playwright/test": "^1.45.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.9"
  }
}
