# TripCazador Web — variables de entorno
# Copia este fichero a .env.local para desarrollo.
# En producción las variables se gestionan desde Vercel → Project → Settings → Environment Variables.

# ── Backend ──────────────────────────────────────────────────────────────
# URL del API FastAPI. En local apunta al Docker / uvicorn.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Booking.com afiliado (IMPORTANTE) ────────────────────────────────────
# AID que te da Booking cuando te aceptan como partner.
# Si no está seteado, los deep-links funcionan pero NO generan comisión.
# Obtener AID: https://partner.booking.com → Affiliate Partner Program
NEXT_PUBLIC_BOOKING_AID=

# ── Analytics (opcional) ─────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=tripcazador.com

# ── Sentry (opcional) ────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
